{
  "manifest_version": 3,
  "name": "Lançador de Diárias",
  "version": "2.0.0",
  "description": "Extrai dados de NFes e preenche o formulário de reembolso de diárias no Mantis, com atalhos para as ferramentas internas mais usadas.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lançador de Diárias",
    "default_icon": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Abrir Lançador de Diárias"
    }
  },
  "icons": {
    "16":  "icon.png",
    "48":  "icon.png",
    "128": "icon.png"
  },
  "permissions": ["activeTab", "scripting", "windows", "storage"],
  "host_permissions": [
    "https://mantis-br.nttdata-solutions.com/*",
    "https://axet.nttdata.com/*",
    "https://ndbs.service-now.com/*",
    "https://performancemanager5.successfactors.eu/*",
    "https://eu.knowbe4.com/*",
    "https://platform.senior.com.br/*",
    "https://authz-sefa.identidadedigital.pr.gov.br/*",
    "https://notaparana.pr.gov.br/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
